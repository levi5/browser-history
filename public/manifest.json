{
  "manifest_version": 2,
  "version": "1.0",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "permissions": ["history", "tabs"],

   "default_locale": "pt",
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

{
  "manifest_version": 3,
  "version": "1.1.1",
  "minimum_chrome_version": "121",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "permissions": [
    "history",
    "tabs",
    "storage"
  ],
  "default_locale": "pt",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{222ce613-0bc0-4a22-b371-96f803b71e38}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
